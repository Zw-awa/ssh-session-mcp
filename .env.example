# Legacy single-device SSH settings
SSH_HOST=YOUR_DEVICE_HOST
SSH_PORT=22
SSH_USER=YOUR_DEVICE_USER
# Use either password or key (key is recommended)
SSH_PASSWORD=
SSH_KEY=
# SSH_PASSWORD_FILE=/run/secrets/ssh_password
# SSH_KEY_FILE=/run/secrets/ssh_private_key

# Instance / profile settings
# SSH_MCP_INSTANCE=default
# SSH_MCP_CONFIG=./ssh-session-mcp.config.json
# SSH_MCP_STATE_DIR=.ssh-session-mcp-state
# Profile auth secrets belong in env vars referenced by config, e.g.
# DEVICE_A_PASSWORD=YOUR_DEVICE_PASSWORD

# Viewer settings
VIEWER_HOST=127.0.0.1
VIEWER_PORT=auto
VIEWER_REFRESH_MS=1000

# Auto open xterm.js terminal page in browser when AI opens a session
AUTO_OPEN_TERMINAL=false

# Operation / logging
SSH_MCP_MODE=safe
SSH_MCP_USE_MARKER=true
SSH_MCP_LOG_MODE=off
# SSH_MCP_LOG_DIR=
# In containers, prefer:
# SSH_MCP_LOG_MODE=stderr

# Distributed v0 control plane
# SSH_MCP_RUNTIME_MODE=distributed
# SSH_MCP_STORE=redis
# SSH_MCP_REDIS_URL=redis://127.0.0.1:6379/0
# SSH_MCP_NODE_ID=node-a
# SSH_MCP_PUBLIC_BASE_URL=https://ssh-mcp.example.com

# Trusted proxy auth for distributed viewer access
# SSH_MCP_AUTH_MODE=proxy
# SSH_MCP_TRUST_PROXY=true
# SSH_MCP_AUTH_USER_HEADER=x-forwarded-user
# SSH_MCP_AUTH_ROLE_HEADER=x-forwarded-role

# Distributed v0 notes:
# - Redis is required for multi-node distributed mode.
# - Cross-node PTY migration is not supported.
# - Transparent cross-node HTTP/WS proxying is not supported.
# - When a session is owned by another node, route the request to the owner node.
