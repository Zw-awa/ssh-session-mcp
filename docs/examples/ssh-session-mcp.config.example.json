{
  "defaults": {
    "viewerHost": "127.0.0.1",
    "viewerPort": "auto",
    "viewerAccessMode": "allow_all",
    "viewerIpAllowlist": [],
    "viewerIpDenylist": [],
    "viewerAllowedOrigins": [],
    "viewerMode": "browser",
    "viewerSingletonScope": "connection",
    "autoOpenTerminal": false,
    "mode": "safe",
    "logMode": "meta"
  },
  "defaultDevice": "DEVICE_A_ID",
  "policyRules": [
    {
      "id": "error-kubectl-delete",
      "pattern": "\\bkubectl\\s+delete\\b",
      "priority": 0,
      "mode": "safe",
      "category": "dangerous",
      "action": "error",
      "message": "kubectl delete is blocked in safe mode",
      "suggestion": "Run the command manually in the viewer if you really intend to delete resources."
    }
  ],
  "devices": [
    {
      "id": "DEVICE_A_ID",
      "label": "Example Primary Target",
      "host": "DEVICE_A_HOST",
      "port": 22,
      "user": "DEVICE_A_USER",
      "auth": {
        "passwordEnv": "DEVICE_A_PASSWORD"
      },
      "defaults": {
        "term": "xterm-256color",
        "cols": 120,
        "rows": 40,
        "idleTimeoutMs": 1800000,
        "closedRetentionMs": 300000,
        "autoOpenViewer": true,
        "viewerMode": "browser"
      },
      "tags": [
        "example",
        "primary"
      ]
    },
    {
      "id": "DEVICE_B_ID",
      "label": "Example Secondary Target",
      "host": "DEVICE_B_HOST",
      "port": 22,
      "user": "DEVICE_B_USER",
      "auth": {
        "keyPath": "/absolute/path/to/ssh/key"
      },
      "defaults": {
        "term": "xterm-256color",
        "cols": 140,
        "rows": 42,
        "autoOpenViewer": false,
        "viewerMode": "terminal"
      },
      "tags": [
        "example",
        "secondary"
      ]
    }
  ]
}
